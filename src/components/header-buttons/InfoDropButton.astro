---
// src/components/header-buttons/InfoDropButton.astro
---
<div class="dropdown-wrapper">
    <button class="header-custom-btn dropdown-trigger">
        Информация
        <svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </button>

    <div class="dropdown-menu">
        <a href="/wiki/about/" class="dropdown-item">О проекте</a>
        <a href="/wiki/features/" class="dropdown-item">Особенности</a>
        <a href="/wiki/rules/rules/" class="dropdown-item">Правила сервера</a>
        <a href="/wiki/guides/home/" class="dropdown-item">Вики</a>
    </div>
</div>

<style>
    @import '../../styles/header-btn.css';

    .dropdown-wrapper { position: relative; display: inline-flex; }

    .dropdown-menu {
        position: absolute !important;
        top: 100%; right: 0;
        margin-top: 8px;
        min-width: 140px;
        background: var(--sl-color-bg);
        border: 1px solid var(--sl-color-gray-4);
        border-radius: 6px;
        padding: 6px 0;
        opacity: 0;
        visibility: hidden;
        transform: translateY(10px);
        transition: 0.2s;
        z-index: 100;
    }

    .dropdown-wrapper:hover .dropdown-menu { opacity: 1; visibility: visible; transform: translateY(0); }

    .dropdown-item {
        display: block;
        padding: 8px 14px;
        font-size: 0.8rem;
        color: var(--sl-color-gray-2);
        text-decoration: none;
    }

    /* Наведение на пункты меню */
    .dropdown-item:hover { background: var(--sl-color-gray-6); color: var(--sl-color-text-accent); }

    .chevron { transition: 0.2s; }
    .dropdown-wrapper:hover .chevron { transform: rotate(180deg); color: var(--sl-color-text-accent); }
</style>