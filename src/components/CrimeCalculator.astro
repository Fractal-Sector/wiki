---
// CrimeCalculator.astro
// src/components/CrimeCalculator.astro
---

<div id="cc">

    <!-- TABLE -->
    <div class="cc-table-wrap">
        <table class="cc-table">
            <thead><tr>
                <th class="cc-th-cat">Категория</th>
                <th class="cc-th"><b class="t1">1-XX</b><br>Незначительное<br><small>2–5 мин · 1 000 K</small></th>
                <th class="cc-th"><b class="t2">2-XX</b><br>Среднее<br><small>5–15 мин · 2 500 K</small></th>
                <th class="cc-th"><b class="t3">3-XX</b><br>Серьёзное<br><small>15–20 мин · 7 500 K</small></th>
                <th class="cc-th"><b class="t4">4-XX</b><br>Исключительное<br><small>20–25 мин · 15 000 K</small></th>
                <th class="cc-th"><b class="t5">5-XX</b><br>Капитальное<br><small>25–35 мин · 25 000 K</small></th>
            </tr></thead>
            <tbody id="cc-tbody"></tbody>
        </table>
    </div>

    <!-- MODIFIERS -->
    <div class="cc-label">Модификаторы ситуации</div>
    <div id="cc-mods"></div>

    <!-- SENTENCER -->
    <div class="cc-label">
        Расчёт приговора
        <button id="cc-clear">Очистить</button>
    </div>

    <div id="cc-sentence">
        <div id="cc-empty">Выбери преступления из таблицы выше</div>
        <div id="cc-result" style="display:none">
            <div id="cc-chips"></div>
            <div id="cc-breakdown"></div>
            <div id="cc-totals">
                <div class="cc-total-row">
                    <span class="cc-total-label">Срок</span>
                    <span class="cc-total-val t-time" id="out-time">—</span>
                </div>
                <div class="cc-total-row">
                    <span class="cc-total-label">Штраф</span>
                    <span class="cc-total-val t-fine" id="out-fine">—</span>
                </div>
            </div>
            <div class="cc-copy-row">
                <button id="cc-copy">Скопировать</button>
                <span id="cc-toast">Скопировано!</span>
            </div>
        </div>
    </div>

    <!-- RULES -->
    <details class="cc-details">
        <summary>Правила стекинга</summary>
        <div class="cc-details-body">
            <p>В пределах одной категории (-XX) засчитывается только самое тяжёлое преступление.<br>
                При нескольких категориях: первая ×100%, вторая ×50%, третья ×25% и т.д.</p>
            <p>Осуждённый может запросить штраф вместо тюрьмы. Офицер вправе назначить принудительные работы с согласия заключённого.</p>
        </div>
    </details>

    <!-- DEFS -->
    <details class="cc-details">
        <summary>Все определения</summary>
        <div id="cc-defs"></div>
    </details>

</div>

<style>
    #cc {
        --bg:  var(--sl-color-bg-nav, #13151a);
        --brd: var(--sl-color-hairline, rgba(255,255,255,.1));
        --txt: var(--sl-color-text, #e2e8f0);
        --dim: var(--sl-color-text-accent, #94a3b8);
        --acc: var(--sl-color-accent, #7c3aed);
        --ach: var(--sl-color-accent-high, #a78bfa);
        --t1: #4ade80; --t2: #facc15; --t3: #fb923c; --t4: #f87171; --t5: #e879f9;
        font-family: var(--sl-font, system-ui, sans-serif);
        font-size: .85rem;
        color: var(--txt);
    }

    /* TABLE */
    .cc-table-wrap { overflow-x: auto; border: 1px solid var(--brd); border-radius: 8px; }
    .cc-table { width: 100%; border-collapse: collapse; }
    .cc-table thead tr { background: var(--bg); }
    .cc-th-cat, .cc-th { padding: .5rem .4rem; border-bottom: 1px solid var(--brd); }
    .cc-th { text-align: center; font-size: .72rem; font-weight: 600; line-height: 1.5; }
    .cc-th-cat { width: 86px; font-size: .68rem; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--dim); }
    .cc-th b { font-size: .72rem; font-weight: 800; }
    .cc-th small { font-size: .6rem; color: var(--dim); font-weight: 400; }
    .t1{color:var(--t1)} .t2{color:var(--t2)} .t3{color:var(--t3)} .t4{color:var(--t4)} .t5{color:var(--t5)}

    /* ROWS */
    .cc-table tbody tr:not(:last-child) { border-bottom: 1px solid var(--brd); }
    .cc-td-cat { padding: .4rem .5rem; color: var(--dim); font-size: .7rem; font-weight: 600; }
    .cc-td-cat small { display: block; font-size: .6rem; opacity: .5; }

    /* CRIME CELLS — these are the <td> elements themselves */
    td.crime-cell {
        padding: .4rem .35rem;
        text-align: center;
        cursor: pointer;
        transition: background .1s;
        user-select: none;
    }
    td.crime-cell:hover { background: rgba(255,255,255,.07); }

    td.crime-cell[data-active="true"][data-color="1"] { background: rgba(74,222,128,.18);  outline: 2px solid var(--t1) inset; }
    td.crime-cell[data-active="true"][data-color="2"] { background: rgba(250,204,21,.18);  outline: 2px solid var(--t2) inset; }
    td.crime-cell[data-active="true"][data-color="3"] { background: rgba(251,146,60,.18);  outline: 2px solid var(--t3) inset; }
    td.crime-cell[data-active="true"][data-color="4"] { background: rgba(248,113,113,.18); outline: 2px solid var(--t4) inset; }
    td.crime-cell[data-active="true"][data-color="5"] { background: rgba(232,121,249,.18); outline: 2px solid var(--t5) inset; }

    td.crime-cell[data-active="true"] .c-name { color: inherit; }
    td.crime-cell[data-color="1"] .c-code { color: var(--t1); }
    td.crime-cell[data-color="2"] .c-code { color: var(--t2); }
    td.crime-cell[data-color="3"] .c-code { color: var(--t3); }
    td.crime-cell[data-color="4"] .c-code { color: var(--t4); }
    td.crime-cell[data-color="5"] .c-code { color: var(--t5); }
    td.crime-cell[data-active="true"][data-color="1"] .c-name { color: var(--t1); }
    td.crime-cell[data-active="true"][data-color="2"] .c-name { color: var(--t2); }
    td.crime-cell[data-active="true"][data-color="3"] .c-name { color: var(--t3); }
    td.crime-cell[data-active="true"][data-color="4"] .c-name { color: var(--t4); }
    td.crime-cell[data-active="true"][data-color="5"] .c-name { color: var(--t5); }

    .c-code { display: block; font-size: .65rem; font-weight: 800; letter-spacing: .04em; }
    .c-name { display: block; font-size: .72rem; line-height: 1.25; word-break: break-word; color: var(--txt); }
    .c-empty { display: block; color: var(--brd); font-size: .85rem; padding: .4rem 0; }

    /* SECTION LABEL */
    .cc-label {
        display: flex; align-items: center; gap: .5rem;
        font-size: .72rem; font-weight: 700; letter-spacing: .07em;
        text-transform: uppercase; color: var(--dim);
        margin: 1.4rem 0 .55rem;
    }
    .cc-label button {
        margin-left: auto; padding: .2rem .6rem; font-size: .7rem;
        background: transparent; border: 1px solid var(--brd);
        border-radius: 5px; color: var(--dim); cursor: pointer;
    }
    .cc-label button:hover { border-color: var(--t4); color: var(--t4); }

    /* MODIFIERS */
    #cc-mods { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px,1fr)); gap: .4rem; margin-bottom: .6rem; }

    .mod-pill {
        display: flex; align-items: flex-start; gap: .5rem;
        padding: .55rem .7rem;
        background: var(--bg); border: 1px solid var(--brd); border-radius: 7px;
        cursor: pointer; text-align: left; color: var(--txt);
        transition: border-color .12s, background .12s;
    }
    .mod-pill:hover { border-color: var(--acc); }

    /* punish = red tint when active, beneficial = green tint */
    .mod-pill.punish[data-active="true"]     { background: rgba(248,113,113,.12); border-color: var(--t4); }
    .mod-pill.beneficial[data-active="true"] { background: rgba(74,222,128,.10);  border-color: var(--t1); }

    .mod-icon { font-size: 1rem; flex-shrink: 0; margin-top: .1rem; }
    .mod-body { flex: 1; min-width: 0; }
    .mod-head { display: flex; align-items: center; gap: .35rem; flex-wrap: wrap; margin-bottom: .2rem; }
    .mod-name { font-size: .76rem; font-weight: 700; }
    .mod-badge { font-size: .67rem; font-weight: 800; padding: .07rem .28rem; border-radius: 3px; white-space: nowrap; }
    .mod-badge.pos { background: rgba(248,113,113,.18); color: var(--t4); }
    .mod-badge.neg { background: rgba(74,222,128,.18);  color: var(--t1); }
    .mod-desc { font-size: .62rem; font-weight: 400; color: var(--dim); line-height: 1.3; }

    /* SENTENCE BOX */
    #cc-sentence { background: var(--bg); border: 1px solid var(--brd); border-radius: 8px; padding: 1rem 1.1rem; }
    #cc-empty { text-align: center; color: var(--dim); padding: 1.5rem 0; }

    /* chips */
    #cc-chips { display: flex; flex-wrap: wrap; gap: .3rem; margin-bottom: .9rem; }
    .chip {
        display: inline-flex; align-items: center; padding: .18rem .5rem;
        border-radius: 99px; font-size: .68rem; font-weight: 600;
        border: 1px solid var(--brd); background: rgba(255,255,255,.04);
        cursor: pointer;
    }
    .chip:hover { opacity: .6; text-decoration: line-through; }
    .chip[data-t="1"]{border-color:var(--t1);color:var(--t1)}
    .chip[data-t="2"]{border-color:var(--t2);color:var(--t2)}
    .chip[data-t="3"]{border-color:var(--t3);color:var(--t3)}
    .chip[data-t="4"]{border-color:var(--t4);color:var(--t4)}
    .chip[data-t="5"]{border-color:var(--t5);color:var(--t5)}

    /* breakdown */
    #cc-breakdown { margin-bottom: .8rem; }
    .bd-title { font-size: .65rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--dim); margin-bottom: .35rem; }
    .bd-row {
        display: grid; grid-template-columns: auto 1fr auto auto;
        gap: .4rem; align-items: center;
        padding: .28rem .4rem; border-radius: 5px; font-size: .78rem;
    }
    .bd-row:nth-child(even) { background: rgba(255,255,255,.025); }
    .bd-badge { font-size: .62rem; font-weight: 800; padding: .08rem .28rem; border-radius: 3px; white-space: nowrap; }
    .bd-name  { color: var(--txt); }
    .bd-mult  { font-size: .65rem; color: var(--dim); white-space: nowrap; }
    .bd-val   { font-weight: 700; text-align: right; white-space: nowrap; }
    .bd-sep   { height: 1px; background: var(--brd); margin: .3rem 0; }
    .bd-sum   { display: flex; justify-content: flex-end; gap: .8rem; font-size: .72rem; color: var(--dim); padding: .2rem .4rem; }

    .mod-bd-row {
        display: flex; align-items: center; gap: .5rem;
        padding: .22rem .4rem; font-size: .76rem;
    }
    .mod-bd-name { flex: 1; color: var(--txt); }
    .mod-bd-val  { font-weight: 700; white-space: nowrap; }
    .mod-bd-val.pos { color: var(--t4); }
    .mod-bd-val.neg { color: var(--t1); }

    /* totals */
    #cc-totals { display: flex; gap: 1.5rem; flex-wrap: wrap; background: rgba(255,255,255,.04); border-radius: 7px; padding: .7rem 1rem; margin-bottom: .8rem; }
    .cc-total-row { display: flex; flex-direction: column; gap: .1rem; }
    .cc-total-label { font-size: .65rem; text-transform: uppercase; letter-spacing: .05em; color: var(--dim); }
    .t-time { font-size: 1.4rem; font-weight: 800; color: var(--ach); }
    .t-fine { font-size: 1rem;   font-weight: 700; color: var(--dim); }

    .cc-copy-row { display: flex; align-items: center; gap: .8rem; }
    #cc-copy { padding: .32rem .85rem; background: var(--acc); color: #fff; border: none; border-radius: 6px; font-size: .75rem; font-weight: 600; cursor: pointer; }
    #cc-copy:hover { opacity: .85; }
    #cc-toast { font-size: .72rem; color: var(--t1); opacity: 0; transition: opacity .2s; }
    #cc-toast.show { opacity: 1; }

    /* details */
    .cc-details { margin-top: 1rem; background: var(--bg); border: 1px solid var(--brd); border-radius: 7px; overflow: hidden; }
    .cc-details summary { padding: .6rem .9rem; cursor: pointer; font-size: .78rem; font-weight: 600; list-style: none; }
    .cc-details summary:hover { background: rgba(255,255,255,.03); }
    .cc-details-body { padding: .5rem .9rem .9rem; font-size: .78rem; line-height: 1.6; color: var(--dim); }
    .cc-details-body p { margin: 0 0 .4rem; }
    #cc-defs { display: grid; grid-template-columns: repeat(auto-fill,minmax(260px,1fr)); gap: .5rem; padding: .5rem .9rem .9rem; }
    .def-card { background: rgba(255,255,255,.03); border: 1px solid var(--brd); border-radius: 6px; padding: .5rem .7rem; }
    .def-code { font-size: .62rem; font-weight: 800; letter-spacing: .05em; margin-bottom: .15rem; }
    .def-name { font-size: .76rem; font-weight: 700; margin-bottom: .2rem; }
    .def-desc { font-size: .68rem; color: var(--dim); line-height: 1.4; margin: 0; }
</style>

<script>
    // ── TYPES ──────────────────────────────────────────────────────────────
    type Tier = 1|2|3|4|5;
    interface CrimeDef { code:string; name:string; def:string; }
    interface Crime extends CrimeDef { tier:Tier; catId:string; }
    interface Mod { id:string; name:string; delta:number|null; pct:number|null; icon:string; desc:string; punish:boolean; }
    type TierMap = Partial<Record<Tier,CrimeDef>>;
    type Cat = [string,string,TierMap];

    // ── DATA ───────────────────────────────────────────────────────────────
    const MID:  Record<Tier,number> = {1:3,  2:10, 3:17, 4:22, 5:30};
    const FINE: Record<Tier,number> = {1:1000,2:2500,3:7500,4:15000,5:25000};

    const CATS: Cat[] = [
        ['00','Угроза движению',{
            1:{code:'1-00',name:'Угроза движению',    def:'Таранить другие корабли, работать без IFF, сбрасывать конструкции в космос.'},
            2:{code:'2-00',name:'Вандализм',           def:'Намеренно уничтожать или повреждать имущество.'},
            3:{code:'3-00',name:'Диверсия',             def:'Злонамеренные действия, препятствующие работе станции или корабля.'},
            5:{code:'5-00',name:'Большая диверсия',    def:'Разрушительные действия, серьёзно угрожающие кораблям или станциям.'},
        }],
        ['01','Угроза жизни',{
            1:{code:'1-01',name:'Халатность',              def:'Рискованное поведение, угрожающее себе или другим.'},
            2:{code:'2-01',name:'Мошенничество',            def:'Подделка документов или удостоверений личности.'},
            3:{code:'3-01',name:'Угроза на рабочем месте',  def:'Безрассудные действия, создающие опасность на общественной станции.'},
            4:{code:'4-01',name:'Особо крупное мошенничество',def:'Подделка официальных документов ГМК, головных ролей.'},
            5:{code:'5-01',name:'Терроризм',                def:'Серия капитальных преступлений или распространение хаоса по всему сектору.'},
        }],
        ['02','Хранение',{
            1:{code:'1-02',name:'Хранение',                 def:'Незаконное хранение контрабанды 2-го класса.'},
            2:{code:'2-02',name:'Ограниченное хранение',    def:'Незаконное хранение контрабанды 3-го класса.'},
            3:{code:'3-02',name:'Контролируемое хранение',  def:'Незаконное хранение контрабанды 4-го класса.'},
        }],
        ['03','Насилие',{
            1:{code:'1-03',name:'Мелкое насилие',            def:'Нежелательный физический контакт или введение вещества без согласия.'},
            2:{code:'2-03',name:'Нападение',                 def:'Угроза применения силы при наличии возможности и/или умысла.'},
            4:{code:'4-03',name:'Непредумышленное убийство', def:'Насилие, повлёкшее непреднамеренную смерть.'},
            5:{code:'5-03',name:'Убийство',                  def:'Убийство разумного существа с умыслом.'},
        }],
        ['04','Кража',{
            1:{code:'1-04',name:'Кража',        def:'Взять имущество без согласия, без применения силы.'},
            2:{code:'2-04',name:'Грабёж',       def:'Взять имущество без согласия, с применением силы или угрозой.'},
            4:{code:'4-04',name:'Похищение',    def:'Незаконно удерживать человека против его воли.'},
            5:{code:'5-04',name:'Крупная кража',def:'Украсть корабль или имущество стоимостью свыше 150 000 Спесо.'},
        }],
        ['05','Проникновение',{
            1:{code:'1-05',name:'Нарушение границ',         def:'Войти в зону и отказаться покинуть её.'},
            2:{code:'2-05',name:'Взлом и проникновение',    def:'Проникновение с умыслом совершить преступление или с повреждением доступа.'},
            4:{code:'4-05',name:'Побег',                    def:'Побег из изолятора CGP или во время принудительных работ.'},
        }],
        ['06','Беспорядки',{
            1:{code:'1-06',name:'Домогательство',           def:'Намеренное разрушительное поведение — физическое или словесное.'},
            2:{code:'2-06',name:'Злоупотребление властью',  def:'Грубое притеснение человека при наличии власти над ним.'},
            3:{code:'3-06',name:'Беспорядки',               def:'Участие в публичных беспорядках с повреждением имущества.'},
            5:{code:'5-06',name:'Подстрекательство',        def:'Действия с целью свержения цепи командования без законного повода.'},
        }],
        ['07','Демонстрация оружия',{
            1:{code:'1-07',name:'Демонстрация оружия',def:'Открытая демонстрация контрабанды в публичной зоне.'},
        }],
        ['08','Жестокость к животным',{
            1:{code:'1-08',name:'Жестокое обращение с животными',  def:'Излишние страдания несапиентному существу со злым умыслом.'},
            3:{code:'3-08',name:'Насилие над сапиентными существами',def:'Излишние страдания сапиентному существу со злым умыслом.'},
        }],
    ];

    const MODS: Mod[] = [
        {id:'evade',     name:'Уклонение от ареста', delta:+10, pct:null,  icon:'', desc:'Побег без применения оружия.',                                                      punish:true },
        {id:'repeat',    name:'Рецидив',              delta:+10, pct:null,  icon:'', desc:'Совершение того же преступления после приговора в эту же смену.',                   punish:true },
        {id:'resist',    name:'Сопротивление аресту', delta:+10, pct:null,  icon:'', desc:'Применение силы против офицеров при попытке ареста.',                             punish:true },
        {id:'cooperate', name:'Сотрудничество',        delta:-10, pct:null,  icon:'', desc:'Следовать инструкциям офицера в меру своих возможностей.',                        punish:false},
        {id:'surrender', name:'Добровольная явка',     delta:null, pct:-0.5, icon:'', desc:'Явиться к ГМК добровольно или позволить задержать себя после побега.',           punish:false},
    ];

    // ── STATE ──────────────────────────────────────────────────────────────
    const selCrimes = new Set<string>();   // crime codes
    const selMods   = new Set<string>();   // mod ids

    // ── HELPERS ────────────────────────────────────────────────────────────
    function getEl(id:string){ return document.getElementById(id); }
    function fmt(min:number){ return min<=0?'0 мин':`${Math.round(min)} мин`; }
    function fmtK(v:number){ return v.toLocaleString('ru-RU')+' K'; }
    function crimeByCode(code:string): Crime|null {
        for(const [catId,,tiers] of CATS)
            for(const [k,c] of Object.entries(tiers) as [string,CrimeDef][])
                if(c.code===code) return {...c, tier:parseInt(k) as Tier, catId};
        return null;
    }

    // ── BUILD TABLE ────────────────────────────────────────────────────────
    function buildTable(){
        const tbody = getEl('cc-tbody')!;
        tbody.innerHTML='';
        for(const [catId,catName,tiers] of CATS){
            const tr = document.createElement('tr');
            // category cell
            const tc = document.createElement('td');
            tc.className='cc-td-cat';
            tc.innerHTML=`${catName}<br><small>X-${catId}</small>`;
            tr.appendChild(tc);
            // tier cells
            for(let t=1;t<=5;t++){
                const tier=t as Tier;
                const td=document.createElement('td');
                const crime=tiers[tier];
                if(crime){
                    td.className='crime-cell';
                    td.dataset.code=crime.code;
                    td.dataset.color=String(tier);
                    if(selCrimes.has(crime.code)) td.setAttribute('data-active','true');
                    td.innerHTML=`<span class="c-code">${crime.code}</span><br><span class="c-name">${crime.name}</span>`;
                    td.onclick=()=>toggleCrime(td, crime.code);
                } else {
                    td.innerHTML='<span class="c-empty">—</span>';
                }
                tr.appendChild(td);
            }
            tbody.appendChild(tr);
        }
    }

    // ── BUILD MODIFIERS ────────────────────────────────────────────────────
    function buildMods(){
        const wrap = getEl('cc-mods')!;
        wrap.innerHTML='';
        for(const m of MODS){
            const btn=document.createElement('button');
            btn.className='mod-pill '+(m.punish?'punish':'beneficial');
            btn.dataset.modId=m.id;
            if(selMods.has(m.id)) btn.setAttribute('data-active','true');
            const isNeg = m.delta!==null ? m.delta<0 : (m.pct!==null && m.pct<0);
            const dStr = m.pct!==null
                ? (m.pct<0?`${m.pct*100}%`:`+${m.pct*100}%`)
                : (m.delta!==null?(m.delta>=0?`+${m.delta} мин`:`${m.delta} мин`):'');
            btn.innerHTML=`
        <span class="mod-icon">${m.icon}</span>
        <div class="mod-body">
          <div class="mod-head">
            <span class="mod-name">${m.name}</span>
            <span class="mod-badge ${isNeg?'neg':'pos'}">${dStr}</span>
          </div>
          <div class="mod-desc">${m.desc}</div>
        </div>`;
            btn.onclick=()=>toggleMod(btn, m.id);
            wrap.appendChild(btn);
        }
    }

    // ── TOGGLE ─────────────────────────────────────────────────────────────
    function toggleCrime(td:HTMLElement, code:string){
        if(selCrimes.has(code)){
            selCrimes.delete(code);
            td.removeAttribute('data-active');
        } else {
            selCrimes.add(code);
            td.setAttribute('data-active','true');
        }
        updateSentence();
    }

    function toggleMod(btn:HTMLElement, id:string){
        if(selMods.has(id)){
            selMods.delete(id);
            btn.removeAttribute('data-active');
        } else {
            selMods.add(id);
            btn.setAttribute('data-active','true');
        }
        updateSentence();
    }

    // ── CALCULATE ──────────────────────────────────────────────────────────
    function calc(){
        const crimes=[...selCrimes].map(crimeByCode).filter((c):c is Crime=>c!==null);
        if(!crimes.length) return null;

        // highest per category
        const byCat:Record<string,Crime>={};
        for(const c of crimes){ const ex=byCat[c.catId]; if(!ex||ex.tier<c.tier) byCat[c.catId]=c; }
        const sorted=Object.values(byCat).sort((a,b)=>b.tier-a.tier);

        let stackTime=0, stackFine=0, mult=1;
        for(const c of sorted){ stackTime+=MID[c.tier]*mult; stackFine+=FINE[c.tier]*mult; mult*=0.5; }

        let flatDelta=0;
        for(const id of selMods){ const m=MODS.find(x=>x.id===id); if(m&&m.delta!==null) flatDelta+=m.delta; }
        let pctMult=1;
        for(const id of selMods){ const m=MODS.find(x=>x.id===id); if(m&&m.pct!==null) pctMult+=m.pct; }

        return {
            crimes, sorted,
            stackTime, stackFine,
            flatDelta, pctMult,
            finalTime: Math.max(0,(stackTime+flatDelta)*pctMult),
            finalFine: Math.max(0, stackFine*pctMult),
        };
    }

    // ── UPDATE SENTENCE ────────────────────────────────────────────────────
    function updateSentence(){
        const empty  = getEl('cc-empty')!;
        const result = getEl('cc-result')!;

        if(!selCrimes.size){ empty.style.display=''; result.style.display='none'; return; }
        const r=calc(); if(!r) return;
        empty.style.display='none'; result.style.display='';

        // chips
        const chips=getEl('cc-chips')!;
        chips.innerHTML='';
        for(const c of r.crimes){
            const s=document.createElement('span');
            s.className='chip'; s.dataset.t=String(c.tier);
            s.title='Нажми чтобы удалить';
            s.textContent=`${c.code} ${c.name}`;
            s.onclick=()=>{
                selCrimes.delete(c.code);
                const td=document.querySelector<HTMLElement>(`.crime-cell[data-code="${c.code}"]`);
                if(td) td.removeAttribute('data-active');
                updateSentence();
            };
            chips.appendChild(s);
        }

        // breakdown
        const bd=getEl('cc-breakdown')!;
        bd.innerHTML='';

        // stacking section
        if(r.sorted.length){
            const title=document.createElement('div'); title.className='bd-title'; title.textContent='Стекинг по категориям';
            bd.appendChild(title);
            let m=1;
            for(let i=0;i<r.sorted.length;i++){
                const c=r.sorted[i];
                const t=MID[c.tier]*m, f=FINE[c.tier]*m;
                const mLabel=m===1?'×100%':`×${Math.round(m*100)}%`;
                const row=document.createElement('div'); row.className='bd-row';
                const colors=['','#4ade80','#facc15','#fb923c','#f87171','#e879f9'];
                const bgs=['','rgba(74,222,128,.15)','rgba(250,204,21,.15)','rgba(251,146,60,.15)','rgba(248,113,113,.15)','rgba(232,121,249,.15)'];
                row.innerHTML=`
          <span class="bd-badge" style="color:${colors[c.tier]};background:${bgs[c.tier]}">${c.code}</span>
          <span class="bd-name">${c.name}</span>
          <span class="bd-mult">${mLabel}</span>
          <span class="bd-val" style="color:${colors[c.tier]}">${fmt(t)} / ${fmtK(f)}</span>`;
                bd.appendChild(row);
                m*=0.5;
            }
            if(r.sorted.length>1){
                const sep=document.createElement('div'); sep.className='bd-sep'; bd.appendChild(sep);
                const sum=document.createElement('div'); sum.className='bd-sum';
                sum.innerHTML=`<span>После стекинга:</span><strong>${fmt(r.stackTime)}</strong><span>${fmtK(r.stackFine)}</span>`;
                bd.appendChild(sum);
            }
        }

        // modifiers section
        if(selMods.size){
            const sep=document.createElement('div'); sep.className='bd-sep'; bd.appendChild(sep);
            const title=document.createElement('div'); title.className='bd-title'; title.textContent='**Модификаторы:**';
            bd.appendChild(title);
            for(const id of selMods){
                const mod=MODS.find(x=>x.id===id); if(!mod) continue;
                const isNeg=mod.delta!==null?mod.delta<0:(mod.pct!==null&&mod.pct<0);
                const vStr=mod.pct!==null
                    ?(mod.pct>=0?`+${mod.pct*100}%`:`${mod.pct*100}%`)
                    :`${(mod.delta??0)>=0?'+':''}${mod.delta??0} мин`;
                const row=document.createElement('div'); row.className='mod-bd-row';
                row.innerHTML=`<span class="mod-bd-name">${mod.icon} ${mod.name}</span><span class="mod-bd-val ${isNeg?'neg':'pos'}">${vStr}</span>`;
                bd.appendChild(row);
            }
        }

        // totals
        getEl('out-time')!.textContent=fmt(r.finalTime);
        getEl('out-fine')!.textContent=fmtK(r.finalFine);
    }

    // ── COPY ───────────────────────────────────────────────────────────────
    function buildMarkup():string{
        const r=calc(); if(!r) return '';
        const lines:string[]=['[bold]ПРИГОВОР[/bold]','','[bold]Преступления:[/bold]'];
        for(const c of r.crimes) lines.push(`  • [bold]${c.code}[/bold] — ${c.name}`);
        if(selMods.size){
            lines.push('','[bold]Модификаторы:[/bold]');
            for(const id of selMods){
                const m=MODS.find(x=>x.id===id); if(!m) continue;
                const v=m.pct!==null?`${m.pct>=0?'+':''}${m.pct*100}%`:`${(m.delta??0)>=0?'+':''}${m.delta??0} мин`;
                lines.push(`  • ${m.name}: ${v}`);
            }
        }
        lines.push('',`[bold]Тюрьма:[/bold] ${fmt(r.finalTime)}`,`[bold]Штраф:[/bold] ${fmtK(r.finalFine)}`);
        return lines.join('\n');
    }

    // ── DEFS ───────────────────────────────────────────────────────────────
    function buildDefs(){
        const grid=getEl('cc-defs')!;
        for(const [,,tiers] of CATS)
            for(const [k,c] of Object.entries(tiers) as [string,CrimeDef][]){
                const d=document.createElement('div'); d.className='def-card';
                d.innerHTML=`<div class="def-code t${k}">${c.code}</div><div class="def-name">${c.name}</div><p class="def-desc">${c.def}</p>`;
                grid.appendChild(d);
            }
    }

    // ── INIT ───────────────────────────────────────────────────────────────
    buildTable();
    buildMods();
    buildDefs();
    updateSentence();

    getEl('cc-clear')!.addEventListener('click',()=>{
        selCrimes.clear(); selMods.clear();
        document.querySelectorAll<HTMLElement>('[data-active="true"]').forEach(el=>el.removeAttribute('data-active'));
        updateSentence();
    });

    getEl('cc-copy')!.addEventListener('click',()=>{
        navigator.clipboard.writeText(buildMarkup()).then(()=>{
            const t=getEl('cc-toast')!;
            t.classList.add('show');
            setTimeout(()=>t.classList.remove('show'),2000);
        });
    });
</script>