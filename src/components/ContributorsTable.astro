---
import data from '../data/contributors.json';
---

<div class="grid">
    {data.map(user => (
            <a href={user.url} class="card" target="_blank">
                <img src={user.avatar} alt={user.login} />
                <span>{user.login}</span>
                <small>{user.prs} PRs</small>
            </a>
    ))}
</div>

<style>
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 1rem;
        padding: 1rem 0;
    }

    .card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-decoration: none;
        color: var(--sl-color-white);
        background: var(--sl-color-gray-6);
        padding: 1rem;
        border-radius: 8px;
        transition: transform 0.2s;
        overflow: hidden;
    }

    .card:hover {
        transform: scale(1.05);
        background: var(--sl-color-gray-5);
    }

    img {
        border-radius: 50%;
        width: 60px;
        height: 60px;
        margin-bottom: 0.5rem;
    }

    span {
        font-size: 0.85rem;
        font-weight: 600;
        text-align: center;
        width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    small {
        font-size: 0.75rem;
        color: var(--sl-color-gray-3);
        margin-top: 0.2rem;
    }
</style>